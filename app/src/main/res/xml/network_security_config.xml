<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only; trust only system CAs (no user-installed CAs), including in debug builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
