<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded reminder notification: the same balloon with the full title, notes and category. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/xp_balloon_background"
    android:orientation="horizontal"
    android:paddingStart="9dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/xp_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/xp_ic_info" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/xp_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/xp_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#202020"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/xp_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="7"
            android:textColor="#202020"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/xp_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#5B5B5B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
