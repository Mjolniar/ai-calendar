<!--
  Control styles for the XP look. Colors come from the palette dictionary (Luna.xaml or Noir.xaml)
  through DynamicResource, so nothing in here is specific to light or dark.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xp="clr-namespace:AICalendar.Desktop.Xp">

    <FontFamily x:Key="Xp.Font">Tahoma, Segoe UI</FontFamily>
    <FontFamily x:Key="Xp.TitleFont">Trebuchet MS, Tahoma, Segoe UI</FontFamily>

    <!-- Close is red in every palette. -->
    <RadialGradientBrush x:Key="Xp.Close" GradientOrigin="0.9,0.9" Center="0.9,0.9" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Offset="0" Color="#CC4600" />
        <GradientStop Offset="0.55" Color="#DC6527" />
        <GradientStop Offset="0.7" Color="#CD7546" />
        <GradientStop Offset="0.9" Color="#FFCCB2" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Xp.CloseHover" GradientOrigin="0.9,0.9" Center="0.9,0.9" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Offset="0" Color="#E85A0C" />
        <GradientStop Offset="0.55" Color="#F27C3C" />
        <GradientStop Offset="0.7" Color="#E88F60" />
        <GradientStop Offset="0.9" Color="#FFDCC8" />
        <GradientStop Offset="1" Color="#FFFFFF" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Xp.ClosePressed" GradientOrigin="0.9,0.9" Center="0.9,0.9" RadiusX="1.25" RadiusY="1.25">
        <GradientStop Offset="0" Color="#8C2A00" />
        <GradientStop Offset="0.6" Color="#B04010" />
        <GradientStop Offset="1" Color="#D07850" />
    </RadialGradientBrush>

    <!-- Glyphs, drawn on the 21 x 21 caption button and the 17 x 17 scroll button. -->
    <Geometry x:Key="Xp.GlyphMinimize">M5,13 H12 V16 H5 Z</Geometry>
    <Geometry x:Key="Xp.GlyphMaximize">F0 M5,5 H16 V16 H5 Z M6.5,8 V14.5 H14.5 V8 Z</Geometry>
    <Geometry x:Key="Xp.GlyphRestore">F0 M8,4 H17 V13 H14 V11.5 H15.5 V6.5 H9.5 V8 H8 Z M4,8 H13 V17 H4 Z M5.5,10.5 V15.5 H11.5 V10.5 Z</Geometry>
    <Geometry x:Key="Xp.GlyphClose">M6.5,6.5 L14.5,14.5 M14.5,6.5 L6.5,14.5</Geometry>
    <Geometry x:Key="Xp.ArrowUp">M4.5,10 L8.5,6 L12.5,10 Z</Geometry>
    <Geometry x:Key="Xp.ArrowDown">M4.5,7 L8.5,11 L12.5,7 Z</Geometry>
    <Geometry x:Key="Xp.ArrowLeft">M10,4.5 L6,8.5 L10,12.5 Z</Geometry>
    <Geometry x:Key="Xp.ArrowRight">M7,4.5 L11,8.5 L7,12.5 Z</Geometry>
    <Geometry x:Key="Xp.Chevron">M4,6 L8,10 L12,6</Geometry>
    <Geometry x:Key="Xp.Tick">M3.2,7.8 L6.2,10.8 L11.8,4</Geometry>

    <Style x:Key="Xp.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="3" SnapsToDevicePixels="True" Stroke="{DynamicResource Xp.Text}"
                               StrokeThickness="1" StrokeDashArray="1 2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ window -->

    <Style x:Key="Xp.CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Xp.Caption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Xp.CaptionEdge}" BorderThickness="1" />
                        <Path Width="21" Height="21" Fill="White"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.CaptionHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.CaptionPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.CaptionCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" CornerRadius="3" Background="{StaticResource Xp.Close}"
                                BorderBrush="{DynamicResource Xp.CaptionEdge}" BorderThickness="1" />
                        <Path Width="21" Height="21" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="{StaticResource Xp.GlyphClose}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Xp.CloseHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource Xp.ClosePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption, frame and caption buttons. XpWindow applies this style to itself. -->
    <Style x:Key="Xp.WindowStyle" TargetType="{x:Type xp:XpWindow}">
        <Setter Property="Background" Value="{DynamicResource Xp.Face}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Xp.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type xp:XpWindow}">
                    <Border x:Name="Outer" Background="{DynamicResource Xp.WindowFrame}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="29" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Caption" Grid.Row="0" Background="{DynamicResource Xp.Title}">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,5,0"
                                                VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button x:Name="Minimize" Style="{StaticResource Xp.CaptionButton}" ToolTip="Minimize"
                                                Content="{StaticResource Xp.GlyphMinimize}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}" />
                                        <Button x:Name="Maximize" Style="{StaticResource Xp.CaptionButton}" ToolTip="Maximize"
                                                Content="{StaticResource Xp.GlyphMaximize}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}" />
                                        <Button x:Name="Restore" Style="{StaticResource Xp.CaptionButton}" ToolTip="Restore Down"
                                                Content="{StaticResource Xp.GlyphRestore}" Visibility="Collapsed"
                                                Command="{x:Static SystemCommands.RestoreWindowCommand}" />
                                        <Button x:Name="Close" Style="{StaticResource Xp.CaptionCloseButton}" ToolTip="Close"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}" />
                                    </StackPanel>
                                    <Image DockPanel.Dock="Left" Source="{DynamicResource Icon.App}" Width="16" Height="16"
                                           Margin="7,0,6,0" VerticalAlignment="Center" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleShadow" Text="{TemplateBinding Title}" Margin="1,1.5,0,0"
                                                   Foreground="{DynamicResource Xp.TitleShadow}"
                                                   FontFamily="{StaticResource Xp.TitleFont}" FontWeight="Bold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}"
                                                   Foreground="{DynamicResource Xp.TitleText}"
                                                   FontFamily="{StaticResource Xp.TitleFont}" FontWeight="Bold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border x:Name="Client" Grid.Row="1" Margin="4,0,4,4" Background="{TemplateBinding Background}">
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Border>
                            <!-- Size grip in the corner of a window that can be resized: six etched dots. -->
                            <Grid x:Name="Grip" Grid.Row="1" Width="13" Height="13" Margin="0,0,5,5" Visibility="Collapsed"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Border Background="Transparent" WindowChrome.ResizeGripDirection="BottomRight" />
                                <Path IsHitTestVisible="False" Fill="{DynamicResource Xp.EtchLight}"
                                      Data="M10,2 h2 v2 h-2 Z M6,6 h2 v2 h-2 Z M10,6 h2 v2 h-2 Z M2,10 h2 v2 h-2 Z M6,10 h2 v2 h-2 Z M10,10 h2 v2 h-2 Z" />
                                <Path IsHitTestVisible="False" Fill="{DynamicResource Xp.Shadow}"
                                      Data="M9,1 h2 v2 h-2 Z M5,5 h2 v2 h-2 Z M9,5 h2 v2 h-2 Z M1,9 h2 v2 h-2 Z M5,9 h2 v2 h-2 Z M9,9 h2 v2 h-2 Z" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CaptionActive" Value="False">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource Xp.WindowFrameInactive}" />
                            <Setter TargetName="Caption" Property="Background" Value="{DynamicResource Xp.TitleInactive}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Xp.TitleTextInactive}" />
                            <Setter TargetName="TitleShadow" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanResize">
                            <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <!-- A maximized window hangs over the screen edge by its resize border. -->
                            <Setter TargetName="Outer" Property="Padding" Value="7" />
                            <Setter TargetName="Client" Property="Margin" Value="0" />
                            <Setter TargetName="Grip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Maximize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Restore" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="Minimize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->

    <Style TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Xp.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" CornerRadius="3" BorderThickness="1"
                                Background="{DynamicResource Xp.ButtonFill}" BorderBrush="{DynamicResource Xp.ButtonBorder}" />
                        <Border x:Name="Ring" CornerRadius="2" Margin="1" BorderThickness="2" BorderBrush="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Xp.DefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Xp.DefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Xp.HoverRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.ButtonPressedFill}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.ButtonDisabledFill}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Xp.DisabledBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Underlined text that acts like a button. Content must be a string. -->
    <Style x:Key="Xp.LinkButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Xp.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Link}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="1,2">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The small "x" that dismisses a bar or a balloon. -->
    <Style x:Key="Xp.DismissButton" TargetType="{x:Type Button}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.TextDim}" />
        <Setter Property="ToolTip" Value="Dismiss" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Plate" Background="Transparent" CornerRadius="2">
                        <Path Width="22" Height="22" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M7.5,7.5 L14.5,14.5 M14.5,7.5 L7.5,14.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="#33808080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat toolbar button: raised on hover, sunken while pressed or checked. -->
    <ControlTemplate x:Key="Xp.ToolButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Border x:Name="Plate" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.ToolHoverFill}" />
                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Xp.ToolBorder}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.ToolPressedFill}" />
                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Xp.ToolBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.ToolPressedFill}" />
                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Xp.ToolBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Xp.ToolButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Padding" Value="6,3,8,3" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template" Value="{StaticResource Xp.ToolButtonTemplate}" />
    </Style>

    <!--
      A tab of the tab strip, built on a radio button so one is always selected. Mouse only: the
      window moves between tabs with Ctrl+Tab, and arrow keys would check a tab without a click.
    -->
    <Style x:Key="Xp.Tab" TargetType="{x:Type RadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="Root" Margin="0,3,0,0" SnapsToDevicePixels="True">
                        <Border x:Name="Plate" Background="{DynamicResource Xp.TabFill}" CornerRadius="3,3,0,0"
                                BorderBrush="{DynamicResource Xp.TabBorder}" BorderThickness="1,1,1,0" />
                        <Border x:Name="Accent" Height="3" VerticalAlignment="Top" CornerRadius="3,3,0,0" Visibility="Collapsed"
                                Background="{DynamicResource Xp.TabAccentLight}"
                                BorderBrush="{DynamicResource Xp.TabAccent}" BorderThickness="0,1,0,0" />
                        <ContentPresenter x:Name="Label" Margin="11,4,11,3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The selected tab is taller and covers the strip's bottom line. -->
                            <Setter TargetName="Root" Property="Margin" Value="-2,0,-2,-1" />
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.TabSelected}" />
                            <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Margin" Value="13,5,13,5" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ check box -->

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                        <BulletDecorator.Bullet>
                            <Grid Width="15" Height="15">
                                <Border x:Name="Box" Background="{DynamicResource Xp.CheckFill}"
                                        BorderBrush="{DynamicResource Xp.CheckBorder}" BorderThickness="1" />
                                <Border x:Name="Hover" Margin="1" BorderThickness="2" BorderBrush="Transparent" />
                                <Path x:Name="Tick" Visibility="Collapsed" Stroke="{DynamicResource Xp.CheckGreen}"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="{StaticResource Xp.Tick}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Xp.HoverRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Xp.DefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Xp.CheckPressedFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Xp.DisabledBorder}" />
                            <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Xp.TextDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Option button: the check box's round sibling, with a green dot like the phone's. -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <BulletDecorator Background="Transparent" SnapsToDevicePixels="True">
                        <BulletDecorator.Bullet>
                            <Grid Width="15" Height="15">
                                <Ellipse x:Name="Circle" Fill="{DynamicResource Xp.CheckFill}" Stroke="{DynamicResource Xp.CheckBorder}" StrokeThickness="1" />
                                <Ellipse x:Name="Hover" Margin="1" StrokeThickness="2" Stroke="Transparent" />
                                <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed" Fill="{DynamicResource Xp.CheckGreen}" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Stroke" Value="{DynamicResource Xp.HoverRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hover" Property="Stroke" Value="{DynamicResource Xp.DefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Xp.CheckPressedFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Xp.DisabledBorder}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Xp.TextDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ edit fields -->

    <!-- Right-click menus for text. The menus that edit fields bring along are drawn by the system. -->
    <ContextMenu x:Key="Xp.EditMenu">
        <MenuItem Command="ApplicationCommands.Cut" />
        <MenuItem Command="ApplicationCommands.Copy" />
        <MenuItem Command="ApplicationCommands.Paste" />
        <Separator />
        <MenuItem Command="ApplicationCommands.SelectAll" />
    </ContextMenu>
    <ContextMenu x:Key="Xp.CopyMenu">
        <MenuItem Command="ApplicationCommands.Copy" />
        <Separator />
        <MenuItem Command="ApplicationCommands.SelectAll" />
    </ContextMenu>
    <ContextMenu x:Key="Xp.PasteMenu">
        <MenuItem Command="ApplicationCommands.Paste" />
    </ContextMenu>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Xp.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xp.FieldBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Xp.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Xp.Highlight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,3" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContextMenu" Value="{StaticResource Xp.EditMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource Xp.Face}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Xp.DisabledBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only text that can still be selected and copied (reminder notes). -->
    <Style x:Key="Xp.SelectableText" TargetType="{x:Type TextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Xp.Highlight}" />
        <Setter Property="ContextMenu" Value="{StaticResource Xp.CopyMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Xp.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xp.FieldBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Xp.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Xp.Highlight}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,3" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContextMenu" Value="{StaticResource Xp.PasteMenu}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ combo box -->

    <ControlTemplate x:Key="Xp.ComboToggle" TargetType="{x:Type ToggleButton}">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border x:Name="Drop" Width="17" Margin="0,2,2,2" HorizontalAlignment="Right" CornerRadius="2"
                    Background="{DynamicResource Xp.DropFill}" BorderBrush="{DynamicResource Xp.DropBorder}" BorderThickness="1">
                <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{DynamicResource Xp.DropChevron}" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="{StaticResource Xp.Chevron}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Drop" Property="Background" Value="{DynamicResource Xp.DropHoverFill}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Drop" Property="Background" Value="{DynamicResource Xp.DropPressedFill}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource Xp.Window}" BorderBrush="{DynamicResource Xp.FieldBorder}" BorderThickness="1" />
                        <ToggleButton Focusable="False" ClickMode="Press" Template="{StaticResource Xp.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <ContentPresenter Margin="6,3,24,3" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource Xp.Menu}" BorderBrush="{DynamicResource Xp.MenuBorder}"
                                    BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Plate" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.Highlight}" />
                            <Setter Property="Foreground" Value="{DynamicResource Xp.HighlightText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scroll bar -->

    <Style x:Key="Xp.ScrollLine" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Face" Margin="1" CornerRadius="2" Background="{DynamicResource Xp.DropFill}"
                            BorderBrush="{DynamicResource Xp.DropBorder}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Path Width="17" Height="17" Margin="-2" Fill="{DynamicResource Xp.DropChevron}"
                              Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.DropHoverFill}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.DropPressedFill}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.ScrollPage" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.ScrollThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Face" Margin="1,0" CornerRadius="2" Background="{DynamicResource Xp.ScrollThumb}"
                            BorderBrush="{DynamicResource Xp.ScrollThumbBorder}" BorderThickness="1" SnapsToDevicePixels="True">
                        <Canvas Width="7" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Canvas.Top="0" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripLight}" />
                            <Rectangle Canvas.Top="1" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripDark}" />
                            <Rectangle Canvas.Top="3" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripLight}" />
                            <Rectangle Canvas.Top="4" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripDark}" />
                            <Rectangle Canvas.Top="6" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripLight}" />
                            <Rectangle Canvas.Top="7" Width="7" Height="1" Fill="{DynamicResource Xp.ScrollGripDark}" />
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.ScrollThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Face" Margin="0,1" CornerRadius="2" Background="{DynamicResource Xp.ScrollThumbH}"
                            BorderBrush="{DynamicResource Xp.ScrollThumbBorder}" BorderThickness="1" SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Xp.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Xp.ScrollBarVertical" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource Xp.ScrollTrack}" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="17" />
                <RowDefinition Height="*" />
                <RowDefinition Height="17" />
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Style="{StaticResource Xp.ScrollLine}" Command="ScrollBar.LineUpCommand"
                          Content="{StaticResource Xp.ArrowUp}" />
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Xp.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Xp.ScrollThumbVertical}" MinHeight="18" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Xp.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource Xp.ScrollLine}" Command="ScrollBar.LineDownCommand"
                          Content="{StaticResource Xp.ArrowDown}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Xp.ScrollBarHorizontal" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource Xp.ScrollTrackH}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="17" />
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Style="{StaticResource Xp.ScrollLine}" Command="ScrollBar.LineLeftCommand"
                          Content="{StaticResource Xp.ArrowLeft}" />
            <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Xp.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Xp.ScrollThumbHorizontal}" MinWidth="18" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource Xp.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource Xp.ScrollLine}" Command="ScrollBar.LineRightCommand"
                          Content="{StaticResource Xp.ArrowRight}" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="17" />
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Template" Value="{StaticResource Xp.ScrollBarVertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="17" />
                <Setter Property="MinHeight" Value="17" />
                <Setter Property="Template" Value="{StaticResource Xp.ScrollBarHorizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ menus -->

    <Style TargetType="{x:Type Menu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Xp.Face}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="{TemplateBinding Background}" Padding="2,1" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-click and notification-area menus: the same drop-down, on its own. -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Xp.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="3,3,0,0" Background="#48000000" />
                        <Border Margin="0,0,3,3" Background="{DynamicResource Xp.Menu}" BorderBrush="{DynamicResource Xp.MenuBorder}"
                                BorderThickness="1" Padding="2" MinWidth="150">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Margin="2,3" Background="{DynamicResource Xp.MenuBorder}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A menu on the menu bar: the title, and the drop-down with the hard XP shadow. -->
    <ControlTemplate x:Key="Xp.MenuTop" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Plate" Background="Transparent" Padding="8,3">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Grid>
                    <Border Margin="3,3,0,0" Background="#48000000" />
                    <Border Margin="0,0,3,3" Background="{DynamicResource Xp.Menu}" BorderBrush="{DynamicResource Xp.MenuBorder}"
                            BorderThickness="1" Padding="2" MinWidth="170"
                            TextElement.Foreground="{DynamicResource Xp.Text}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.Highlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Xp.HighlightText}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.Highlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Xp.HighlightText}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A command inside a drop-down. Tag="Radio" shows a bullet instead of a tick when checked. -->
    <ControlTemplate x:Key="Xp.MenuLeaf" TargetType="{x:Type MenuItem}">
        <Border x:Name="Plate" Background="Transparent" MinHeight="24" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <Path x:Name="Tick" Width="16" Height="16" Visibility="Collapsed" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="{StaticResource Xp.Tick}" />
                <Ellipse x:Name="Bullet" Width="6" Height="6" Visibility="Collapsed" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="2,3,26,3" VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="Tag" Value="Radio" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Bullet" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Xp.Highlight}" />
                <Setter Property="Foreground" Value="{DynamicResource Xp.HighlightText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Xp.TextDisabled}" />
                <Setter TargetName="Icon" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Template" Value="{StaticResource Xp.MenuLeaf}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Xp.MenuTop}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ group box, tool tip, etched line -->

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,8,0,0" CornerRadius="4" BorderBrush="{DynamicResource Xp.GroupBorder}"
                                BorderThickness="1" Padding="10,13,10,9">
                            <ContentPresenter />
                        </Border>
                        <!-- The caption sits on the border; it needs the face color behind it to break the line. -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Padding="3,0"
                                Background="{DynamicResource Xp.Face}">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource Xp.GroupText}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.TooltipText}" />
        <Setter Property="FontFamily" Value="{StaticResource Xp.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{DynamicResource Xp.Tooltip}" BorderBrush="{DynamicResource Xp.TooltipBorder}"
                            BorderThickness="1" Padding="5,2" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etched separator: dark line over a light line. -->
    <Style x:Key="Xp.Etched" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <StackPanel SnapsToDevicePixels="True">
                        <Border Height="1" Background="{DynamicResource Xp.Shadow}" />
                        <Border Height="1" Background="{DynamicResource Xp.EtchLight}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.EtchedVertical" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True">
                        <Border Width="1" Background="{DynamicResource Xp.Shadow}" />
                        <Border Width="1" Background="{DynamicResource Xp.EtchLight}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bar in the balloon color for a notice above the list. Put a DockPanel inside. -->
    <Style x:Key="Xp.InfoBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Xp.Tooltip}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Xp.Shadow}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="9,3,3,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Xp.TooltipText}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================ lists -->

    <!-- The row template draws everything, selection included; the container adds nothing. -->
    <Style x:Key="Xp.PlainListItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Xp.List" TargetType="{x:Type ListBox}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Xp.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Xp.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Xp.PlainListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
